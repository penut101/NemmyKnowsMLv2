# Leave database values empty to browse the UI with unavailable data states.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only: used by /mlb/api/live-scores to grade finished games.
SUPABASE_SERVICE_ROLE_KEY=
# Must match the Supabase Vault site_revalidate_secret.
REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Database/model jobs use server-side variables, never NEXT_PUBLIC_.
# DATABASE_URL: admin/publisher PostgreSQL connection; use a session pooler for migrations.
# NBA_DATABASE_URL: PostgreSQL connection for nba; leave unset for local SQLite.
# Provider keys and write switches belong in each model environment; see DATABASE_SETUP.md.
